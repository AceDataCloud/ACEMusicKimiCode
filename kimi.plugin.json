        "acemusic_generate_music",
        "acemusic_generate_custom_music",
        "acemusic_generate_lyrics",
        "acemusic_upload_audio",
        "acemusic_cover_audio",
        "acemusic_mashup_audio",
        "acemusic_get_task",
        "acemusic_get_tasks_batch",
        "acemusic_list_tasks"
      ]
    }
  },
  "interface": {
    "displayName": "ACE Music by Ace Data Cloud",
    "shortDescription": "ACE Music tools and original-task results",
    "longDescription": "Create ACE Music songs and lyrics, upload reference audio, cover one owned track, blend two, and retrieve the original task.",
    "developerName": "Ace Data Cloud",
    "websiteURL": "https://platform.acedata.cloud/services/acemusic"
